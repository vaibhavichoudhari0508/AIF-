from collections import deque

# Social media friendship network
graph = {
    "A": ["B", "C"],
    "B": ["A", "D", "E"],
    "C": ["A", "F"],
    "D": ["B"],
    "E": ["B", "F"],
    "F": ["C", "E"]
}

start = "A"

visited = set()
queue = deque()

visited.add(start)
queue.append(start)

print("Starting User:", start)
print("\nUsers connected to", start, "using BFS:")

level = 0

while queue:
    level_size = len(queue)

    print("\nLevel", level, ":", end=" ")

    for _ in range(level_size):
        user = queue.popleft()
        print(user, end=" ")

        for friend in graph[user]:
            if friend not in visited:
                visited.add(friend)
                queue.append(friend)

    level += 1

print("\n\nAll Connected Users:")
print(" -> ".join(visited))
